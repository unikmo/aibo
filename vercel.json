{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "Control-Centre",
  "rewrites": [
    {
      "source": "/",
      "destination": "/v3/index.html"
    },
    {
      "source": "/v3",
      "destination": "/v3/index.html"
    },
    {
      "source": "/v3/",
      "destination": "/v3/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
